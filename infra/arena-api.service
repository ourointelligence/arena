[Unit]
Description=OURO Arena API (read-only, 127.0.0.1:8787)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=arena
Group=arena
WorkingDirectory=/opt/arena
EnvironmentFile=/etc/arena/arena.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/arena/apps/api/dist/main.js
Restart=on-failure
RestartSec=10
MemoryMax=512M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/arena

[Install]
WantedBy=multi-user.target
