[Unit]
Description=OURO Arena lane %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=arena
Group=arena
WorkingDirectory=/opt/arena
EnvironmentFile=/etc/arena/arena.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/arena/apps/runner/dist/main.js %i
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
KillSignal=SIGTERM
MemoryMax=1G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/arena /run/arena
RuntimeDirectory=arena
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0750
LogRateLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
