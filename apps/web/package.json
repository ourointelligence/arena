{
  "name": "@arena/web",
  "private": true,
  "version": "0.1.0",
  "description": "The OURO Arena page: a static Vite build served at https://ourosi.xyz/arena.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "mock": "tsx test/mock-api.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @soak",
    "test:soak": "playwright test --grep @soak"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  }
}
