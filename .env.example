# LLM adapter the lanes use: anthropic (default), openai, gemini or ollama.
OURO_LLM=anthropic
# Model for that adapter. The budget maths below must match this model.
OURO_MODEL=claude-sonnet-5-5
# Provider key for the adapter above.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_URL=

# Daily LLM budget per lane in US dollars. A lane pauses itself when it is reached and resumes at 00:00 UTC.
ARENA_BUDGET_USD_PER_LANE=1
# Price per million tokens of OURO_MODEL (claude-sonnet-5-5 list price: 3 in, 15 out).
ARENA_PRICE_IN_PER_MTOK=3
ARENA_PRICE_OUT_PER_MTOK=15

# Where the runners keep lane state and arena.db. Defaults shown.
ARENA_DATA_DIR=/var/lib/arena
ARENA_RUN_DIR=/run/arena
# API bind address.
ARENA_API_HOST=127.0.0.1
ARENA_API_PORT=8787

# Optional Telegram alerts from infra/health.sh. Log only when unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
